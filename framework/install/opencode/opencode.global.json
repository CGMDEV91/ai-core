{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".ai/non-negotiables.md",
    ".ai/orchestrator.md",
    ".ai/rules/*.md"
  ],
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "date": "allow",
      "date *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "git ls-files*": "allow",
      "git rev-parse*": "allow",
      "git rev-list*": "allow",
      "git fetch*": "allow",
      "git remote get-url*": "allow",
      "git remote -v": "allow",
      "git branch *": "deny",
      "git branch --show-current": "allow",
      "git branch -r*": "allow",
      "git branch -a*": "allow",
      "node .ai/scripts/ai.mjs *": "allow",
      "node .ai/scripts/ai.mjs qa --setup*": "ask",
      "drush": "allow",
      "drush *": "allow",
      "ddev drush": "allow",
      "ddev drush *": "allow",
      "mvn *": "allow",
      "mvn org.sonarsource.scanner.maven:*": "allow",
      "mvn *deploy*": "deny",
      "mvn *release:*": "deny",
      "git add*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git switch*": "deny",
      "git checkout*": "deny",
      "git restore*": "deny",
      "git reset*": "deny",
      "git stash*": "deny",
      "git clean*": "deny",
      "git rebase*": "deny",
      "git merge*": "deny",
      "git cherry-pick*": "deny",
      "git worktree*": "deny",
      "git tag*": "deny",
      "rm -rf*": "deny",
      "env": "deny",
      "printenv*": "deny"
    }
  }
}
