# LF in the repository whatever the OS of the checkout (opencode may run on Windows over a WSL path).
* text=auto eol=lf
*.sh text eol=lf
*.json text eol=lf
*.png binary
*.jpg binary
*.pdf binary
# Generated from the other files of .ai: a merge keeps ours and the post-merge hook regenerates them (setup sets the
# `ours` driver). context/callgraph.json is regenerated by `callpaths --update` (it also rewrites the skills: /scan).
known-issues/INDEX.md merge=ours
context/callgraph.json merge=ours
context/integrations.json merge=ours
